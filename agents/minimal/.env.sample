# Copy this file to .env beside it and fill it in. Git ignores .env.

# Your Git identity for the agent's commits. These enter the agent as they are.
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com

# Stays on the host, which puts it only into requests to GitHub. A fine-grained personal access token for
# Altinn/altinn-apiclient-maskinporten with Contents and Pull requests read and write. The agent clones the
# repository with it at boot.
GITHUB_TOKEN=
